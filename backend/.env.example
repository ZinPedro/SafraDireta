# Copie para .env e preencha a senha do usuario de APLICACAO.
PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=safradireta
PGUSER=safra_app
PGPASSWORD=SUBSTITUA_PELA_SENHA_LOCAL
# Para um servidor remoto, use os parametros e TLS exigidos pelo provedor.
PGSSLMODE=prefer
# Opcional: DATABASE_URL substitui os parametros PG* de conexao.
